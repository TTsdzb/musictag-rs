                        color: Theme.text-secondary;
                        wrap: word-wrap;
                    }

                    Text {
                        text: "• 基于 EBU R128 的 ReplayGain 回放增益扫描与写入";
                        font-family: Theme.font-family;
                        font-size: Theme.font-xs;
                        color: Theme.text-secondary;
                        wrap: word-wrap;
                    }

                    Rectangle { vertical-stretch: 1; }

                    Text {
                        text: "图标基于 Lucide Icons (ISC License) 绘制，支持系统/浅色/深色主题无缝切换。";
                        font-family: Theme.font-family;
                        font-size: Theme.font-xs;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
            vertical-stretch: 0;
        }

        Rectangle {
            height: 52px;
            background: Theme.bg-surface-alt;
            vertical-stretch: 0;

            HorizontalLayout {
                padding-left: Theme.sp-lg;
                padding-right: Theme.sp-lg;
                spacing: Theme.sp-sm;

                Text {
                    text: "Rust + Slint 1.19 Native UI";
                    font-family: Theme.mono-family;
                    font-size: Theme.font-xs;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    ActionButton {
                        text: "确定";
                        variant: "primary";
                        icon: @image-url("../assets/icons/check.svg");
                        has-icon: true;
                        clicked => {
                            AppLogic.close-dialog();
                        }
                    }
                }
            }
        }
    }
}
